{
  "name": "@buttress/crag",
  "description": "Webcomponent buttress-db-service following open-wc recommendations",
  "license": "AGPL-3.0-or-later",
  "author": "Data People Connected LTD",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/datapeopleconnected/crag.git"
  },
  "version": "0.0.21",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./components/buttress-db-service.js": {
      "types": "./dist/components/buttress-db-service.d.ts",
      "default": "./dist/components/buttress-db-service.js"
    },
    "./package.json": "./package.json",
    "./custom-elements.json": "./custom-elements.json"
  },
  "customElements": "custom-elements.json",
  "sideEffects": [
    "./dist/components/*.js"
  ],
  "scripts": {
    "clean": "rimraf dist .test-bundle tsconfig.tsbuildinfo custom-elements.json",
    "start": "tsc && concurrently -k -r \"tsc --watch --preserveWatchOutput\" \"wds\"",
    "build": "rimraf dist tsconfig.tsbuildinfo && tsc --build --pretty && npm run analyze",
    "analyze": "cem analyze --litelement",
    "roll": "rimraf .test-bundle && rollup -c rollup.config.mjs",
    "watch": "tsc --watch --preserveWatchOutput",
    "licence-check": "./.husky/licence-check",
    "test": "npm run build && npm run roll && npm run test:e2e",
    "test:unit": "wtr --config web-test-runner.unit.config.mjs",
    "test:e2e": "node ./scripts/e2e.js wtr --node-resolve",
    "test:watch": "npm run test:unit -- --watch",
    "test:coverage": "npm run test:unit -- --coverage",
    "publint": "publint && attw --pack . --profile esm-only",
    "prepack": "npm run build",
    "prepare": "husky",
    "lint": "eslint . && npm run lint:styles",
    "lint:fix": "eslint . --fix",
    "lint:styles": "stylelint \"src/**/*.ts\"",
    "format": "prettier \"**/*.ts\" --check --ignore-path .gitignore",
    "format:fix": "prettier \"**/*.ts\" --write --ignore-path .gitignore",
    "typecheck": "tsc --noEmit -p . && tsc -p test",
    "check": "npm run lint && npm run format && npm run typecheck && npm run test:coverage"
  },
  "files": [
    "dist",
    "src",
    "custom-elements.json",
    "LICENSE",
    "COPYING"
  ],
  "dependencies": {
    "@lit/context": "^1.1.6",
    "bson": "~6.8.0",
    "lit": "^3.3.3",
    "socket.io-client": "^4.6.1",
    "uuid": "^11.0.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@custom-elements-manifest/analyzer": "^0.11.0",
    "@open-wc/eslint-config": "^13.1.0",
    "@open-wc/testing": "^4.0.0",
    "@rollup/plugin-node-resolve": "^15.3.0",
    "@rollup/plugin-replace": "^6.0.1",
    "@types/mocha": "^10.0.9",
    "@types/node": "^22.20.4",
    "@typescript-eslint/eslint-plugin": "^8.70.1",
    "@typescript-eslint/parser": "^8.70.1",
    "@web/dev-server": "^0.4.6",
    "@web/dev-server-esbuild": "^1.0.2",
    "@web/dev-server-import-maps": "^0.2.1",
    "@web/dev-server-rollup": "^0.6.4",
    "@web/test-runner": "^0.19.0",
    "concurrently": "^8.0.1",
    "esbuild": "^0.19.12",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import-x": "^4.17.1",
    "husky": "^9.1.4",
    "lint-staged": "^13.2.1",
    "postcss-lit": "^1.4.1",
    "prettier": "^3.9.9",
    "publint": "^0.2.12",
    "rimraf": "^5.0.10",
    "rollup": "^2.79.2",
    "stylelint": "^17.15.0",
    "typescript": "^5.0.4"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=24",
      "onFail": "error"
    }
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix",
      "prettier --write"
    ]
  }
}
