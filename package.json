{
  "name": "@buttress/crag",
  "description": "Webcomponent buttress-db-service following open-wc recommendations",
  "license": "AGPL-3.0-or-later",
  "author": "Data People Connected LTD",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/datapeopleconnected/crag.git"
  },
  "version": "0.0.21",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./components/buttress-db-service.js": {
      "types": "./dist/components/buttress-db-service.d.ts",
      "default": "./dist/components/buttress-db-service.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "./dist/components/*.js"
  ],
  "scripts": {
    "clean": "rimraf dist .test-bundle tsconfig.tsbuildinfo",
    "start": "tsc && concurrently -k -r \"tsc --watch --preserveWatchOutput\" \"wds\"",
    "build": "rimraf dist tsconfig.tsbuildinfo && tsc --build --pretty",
    "roll": "rimraf .test-bundle && rollup -c rollup.config.mjs",
    "watch": "tsc --watch --preserveWatchOutput",
    "licence-check": "./.husky/licence-check",
    "test": "npm run build && npm run roll && npm run test:e2e",
    "test:unit": "wtr --config web-test-runner.unit.config.mjs",
    "test:e2e": "node ./scripts/e2e.js wtr --node-resolve",
    "test:watch": "npm run test:unit -- --watch",
    "test:coverage": "npm run test:unit -- --coverage",
    "publint": "publint && attw --pack . --profile esm-only",
    "prepack": "npm run build",
    "prepare": "husky",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier \"**/*.ts\" --check --ignore-path .gitignore",
    "format:fix": "prettier \"**/*.ts\" --write --ignore-path .gitignore",
    "typecheck": "tsc --noEmit -p . && tsc -p test",
    "check": "npm run lint && npm run format && npm run typecheck && npm run test:coverage"
  },
  "files": [
    "dist",
    "src",
    "LICENSE",
    "COPYING"
  ],
  "dependencies": {
    "@lit/context": "^1.1.6",
    "bson": "~6.8.0",
    "lit": "^3.3.3",
    "socket.io-client": "^4.6.1",
    "uuid": "^11.0.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@open-wc/eslint-config": "^13.1.0",
    "@open-wc/testing": "^5.0.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-replace": "^6.0.3",
    "@types/mocha": "^10.0.10",
    "@web/dev-server": "^1.0.0",
    "@web/dev-server-esbuild": "^2.0.0",
    "@web/dev-server-import-maps": "^0.3.0",
    "@web/dev-server-rollup": "^1.0.0",
    "@web/test-runner": "^1.0.0",
    "concurrently": "^10.0.5",
    "esbuild": "^0.28.2",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "prettier": "^3.9.9",
    "publint": "^0.3.24",
    "rimraf": "^6.1.3",
    "rollup": "^4.63.5",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.1"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=24",
      "onFail": "error"
    }
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix",
      "prettier --write"
    ]
  }
}
