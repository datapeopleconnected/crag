{
  "name": "@buttress/crag",
  "description": "Webcomponent buttress-db-service following open-wc recommendations",
  "license": "AGPL-3.0-or-later",
  "author": "Data People Connected LTD",
  "version": "0.0.21",
  "type": "module",
  "main": "./development/index.js",
  "module": "./development/index.js",
  "types": "./development/index.d.ts",
  "exports": {
    ".": {
      "types": "./development/index.d.ts",
      "development": "./development/index.js",
      "default": "./index.js"
    },
    "./components/buttress-db-service.js": {
      "types": "./development/components/buttress-db-service.d.ts",
      "development": "./development/components/buttress-db-service.js",
      "default": "./components/buttress-db-service.js"
    }
  },
  "scripts": {
    "analyze": "cem analyze --litelement",
    "clean": "rimraf development dist components types ./ButtressDataService.* ./ButtressDbService.* ./ButtressRealtime.* ./ButtressSchema.* ./ButtressSchemaFactory.* ./ButtressStore.* ./helpers.* ./index.* test-app-token.json tsconfig.tsbuildinfo",
    "start": "tsc && concurrently -k -r \"tsc --watch --preserveWatchOutput\" \"wds\"",
    "build": "rimraf development tsconfig.tsbuildinfo && tsc --build --pretty && cp -R development/* .",
    "roll": "rimraf dist && rollup -c rollup.config.mjs",
    "watch": "tsc --watch --preserveWatchOutput",
    "licence-check": "./.husky/licence-check",
    "lint": "eslint --ext .ts,.html . --ignore-path .gitignore && prettier \"**/*.ts\" --check --ignore-path .gitignore",
    "format": "eslint --ext .ts,.html . --fix --ignore-path .gitignore && prettier \"**/*.ts\" --write --ignore-path .gitignore",
    "test": "npm run build && npm run roll && npm run test:e2e",
    "test:unit": "npm run build && npm run roll && wtr --config web-test-runner.unit.config.mjs --node-resolve",
    "test:e2e": "node ./scripts/before-e2e.js && wtr --node-resolve",
    "test:watch": "tsc && concurrently -k -r \"tsc --watch --preserveWatchOutput\" \"wtr --watch\"",
    "storybook": "tsc && npm run analyze -- --exclude dist && concurrently -k -r \"tsc --watch --preserveWatchOutput\" \"wds -c .storybook/server.mjs\"",
    "storybook:build": "tsc && npm run analyze -- --exclude dist && build-storybook",
    "package": "cp -R development/* . && rm -rf test",
    "prepublishOnly": "npm run test && npm run package",
    "prepare": "husky"
  },
  "files": [
    "/components/*.{js,d.ts}",
    "/types/*.{js,d.ts}",
    "ButtressDataService.{js,d.ts}",
    "ButtressDbService.{js,d.ts}",
    "ButtressRealtime.{js,d.ts}",
    "ButtressSchema.{js,d.ts}",
    "ButtressSchemaFactory.{js,d.ts}",
    "ButtressStore.{js,d.ts}",
    "helpers.{js,d.ts}",
    "index.{js,d.ts}",
    "/LICENSE"
  ],
  "dependencies": {
    "@lighten/ltn-element": "0.0.7",
    "bson": "~6.8.0",
    "lit": "^2.7.2",
    "socket.io-client": "^4.6.1",
    "uuid": "^11.0.0"
  },
  "devDependencies": {
    "@custom-elements-manifest/analyzer": "^0.8.0",
    "@open-wc/eslint-config": "^12.0.3",
    "@open-wc/testing": "^4.0.0",
    "@rollup/plugin-commonjs": "^28.0.0",
    "@rollup/plugin-node-resolve": "^15.3.0",
    "@rollup/plugin-replace": "^6.0.1",
    "@rollup/plugin-typescript": "^12.1.0",
    "@types/mocha": "^10.0.9",
    "@types/node": "^18.15.11",
    "@typescript-eslint/eslint-plugin": "^8.9.0",
    "@typescript-eslint/parser": "^8.9.0",
    "@web/dev-server-esbuild": "^1.0.2",
    "@web/dev-server-import-maps": "^0.2.1",
    "@web/dev-server-rollup": "^0.6.4",
    "@web/test-runner": "^0.19.0",
    "concurrently": "^8.0.1",
    "eslint": "^9.12.0",
    "eslint-config-prettier": "^9.1.0",
    "husky": "^9.1.4",
    "lint-staged": "^13.2.1",
    "mocha": "^10.7.3",
    "prettier": "^2.8.7",
    "rimraf": "^5.0.10",
    "rollup": "^2.79.2",
    "tslib": "^2.5.0",
    "typescript": "^5.0.4"
  },
  "customElements": "custom-elements.json",
  "eslintConfig": {
    "parser": "@typescript-eslint/parser",
    "extends": [
      "@open-wc",
      "prettier"
    ],
    "plugins": [
      "@typescript-eslint"
    ],
    "rules": {
      "no-unused-vars": "off",
      "no-continue": "off",
      "no-bitwise": "off",
      "no-promise-executor-return": "off",
      "@typescript-eslint/no-unused-vars": 2,
      "import/no-unresolved": "off",
      "import/extensions": [
        "error",
        "always",
        {
          "ignorePackages": true
        }
      ]
    }
  },
  "prettier": {
    "singleQuote": true,
    "arrowParens": "avoid"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix",
      "prettier --write"
    ]
  }
}
